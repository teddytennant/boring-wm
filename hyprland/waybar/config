[
  {
    "battery": {
      "bat": "BAT0",
      "format": "{icon} {capacity}%",
      "format-charging": "󰂄 {capacity}%",
      "format-icons": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ],
      "format-plugged": "󰚥 {capacity}%",
      "interval": 30,
      "on-click": "$HOME/bin/power-profile-picker",
      "states": {
        "critical": 15,
        "warning": 30
      },
      "tooltip-format": "{timeTo} — {power}W"
    },
    "bluetooth": {
      "format-connected": "󰂱 {device_alias}",
      "format-off": "󰂲",
      "format-on": "󰂯",
      "on-click": "ghostty --class=bluetooth-tui -e bluetui",
      "tooltip-format-connected": "{device_enumerate}"
    },
    "clock": {
      "format": "󰥔 {:%a %b %d  %H:%M:%S}",
      "interval": 1,
      "tooltip-format": "{:%Y-%m-%d}"
    },
    "cpu": {
      "format": " {usage}%",
      "interval": 5
    },
    "custom/dnd": {
      "exec": "makoctl mode | grep -q do-not-disturb && echo '{\"text\": \"󰂛\", \"class\": \"on\", \"tooltip\": \"Do Not Disturb: ON\"}' || echo '{\"text\": \"󰂚\", \"class\": \"off\", \"tooltip\": \"Do Not Disturb: OFF\"}'",
      "interval": 60,
      "on-click": "makoctl mode -t do-not-disturb; pkill -SIGRTMIN+1 waybar",
      "return-type": "json",
      "signal": 1
    },
    "height": 24,
    "hyprland/workspaces": {
      "all-outputs": false,
      "format": "{name}",
      "format-icons": {
        "active": "●",
        "default": "◉",
        "empty": "○",
        "urgent": "●"
      },
      "on-click": "activate",
      "sort-by-number": true,
      "persistent-workspaces": {
        "eDP-1": [
          "1",
          "2"
        ],
        "HDMI-A-1": [
          "3",
          "4",
          "5",
          "6",
          "7"
        ],
        "DP-1": [
          "8",
          "9",
          "10"
        ]
      }
    },
    "layer": "top",
    "margin-left": 0,
    "margin-right": 0,
    "margin-top": 0,
    "memory": {
      "format": "󰍛 {used:0.1f} GB",
      "interval": 5
    },
    "modules-center": [
      "mpris",
      "clock"
    ],
    "modules-left": [
      "hyprland/workspaces"
    ],
    "modules-right": [
      "custom/dnd",
      "pulseaudio",
      "network",
      "bluetooth",
      "cpu",
      "memory",
      "battery"
    ],
    "mpris": {
      "format": "󰎇 {artist} — {title}",
      "format-paused": "󰏤 {artist} — {title}",
      "max-length": 50,
      "tooltip-format": "{artist} — {album} — {title}"
    },
    "network": {
      "format-disconnected": "󰤭 offline",
      "format-ethernet": "󰈀 {ipaddr}",
      "format-wifi": "󰤨 {essid}",
      "on-click": "env XDG_CURRENT_DESKTOP=GNOME gnome-control-center wifi",
      "tooltip-format-wifi": "{signalStrength}% {ipaddr}"
    },
    "position": "top",
    "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-icons": {
        "default": [
          "󰕿",
          "󰖀",
          "󰕾"
        ]
      },
      "format-muted": "󰝟 muted",
      "on-click": "pavucontrol",
      "on-click-right": "swayosd-client --output-volume mute-toggle",
      "scroll-step": 5,
      "tooltip-format": "{desc} {volume}%"
    },
    "spacing": 0,
    "margin-bottom": 0
  }
]
